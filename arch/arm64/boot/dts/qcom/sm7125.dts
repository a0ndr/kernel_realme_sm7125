					port@4 {
						reg = <0x05>;

						endpoint {
							slave-mode;
							remote-endpoint = <0x1e2>;
							phandle = <0x1b7>;
						};
					};

					port@1 {
						reg = <0x00>;

						endpoint {
							slave-mode;
							remote-endpoint = <0x1df>;
							phandle = <0x1b4>;
						};
					};

					port@3 {
						reg = <0x02>;

