						qcom,batif@1200 {
							interrupts = <0x00 0x12 0x00 0x01 0x00 0x12 0x02 0x03 0x00 0x12 0x03 0x03 0x00 0x12 0x04 0x03 0x00 0x12 0x05 0x03 0x00 0x12 0x06 0x03 0x00 0x12 0x07 0x03>;
							interrupt-names = "bat-temp", "bat-ov", "bat-low", "bat-therm-or-id-missing", "bat-terminal-missing", "buck-oc", "vph-ov";
							reg = <0x1200 0x100>;
						};

						qcom,chgr@1000 {
							interrupts = <0x00 0x10 0x00 0x01 0x00 0x10 0x02 0x01 0x00 0x10 0x03 0x01 0x00 0x10 0x04 0x01 0x00 0x10 0x05 0x01 0x00 0x10 0x06 0x01 0x00 0x10 0x07 0x01>;
							interrupt-names = "chgr-error", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "fg-fvcal-qualified", "vph-alarm", "vph-drop-prechg";
							reg = <0x1000 0x100>;
						};
					};

					qcom,power-on@800 {
						qcom,s3-debounce = <0x80>;
						qcom,pmicwd;
						interrupts = <0x00 0x08 0x00 0x00 0x00 0x08 0x01 0x00>;
						qcom,pon-dbc-delay = <0x3d09>;
						compatible = "qcom,qpnp-power-on";
						qcom,s3-src = "kpdpwr-and-resin";
						qcom,system-reset;
						interrupt-names = "kpdpwr", "resin";
						reg = <0x800 0x100>;
						qcom,kpdpwr-sw-debounce;
						qcom,store-hard-reset-reason;

						qcom,pon_1 {
							qcom,pull-up;
							qcom,pon-type = <0x00>;
							qcom,support-reset = <0x00>;
							linux,code = <0x74>;
						};
					};

