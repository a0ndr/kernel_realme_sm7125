					pinctrl@c000 {
						qcom,gpios-disallowed = <0x05 0x06 0x0a>;
						gpio-controller;
						interrupts = <0x00 0xc0 0x00 0x00 0x00 0xc1 0x00 0x00 0x00 0xc2 0x00 0x00 0x00 0xc3 0x00 0x00 0x00 0xc6 0x00 0x00 0x00 0xc7 0x00 0x00 0x00 0xc8 0x00 0x00>;
						compatible = "qcom,spmi-gpio";
						interrupt-names = "pm6150_gpio1", "pm6150_gpio2", "pm6150_gpio3", "pm6150_gpio4", "pm6150_gpio7", "pm6150_gpio8", "pm6150_gpio9";
						reg = <0xc000 0xa00>;
						phandle = <0x2e1>;
						#gpio-cells = <0x02>;

						sdm_skin_therm {

							sdm_skin_therm_default {
								pins = "gpio8";
								bias-high-impedance;
								phandle = <0x6d>;
							};
						};

						dischg_disable {
							function = "normal";
							pins = "gpio3";
							bias-disable;
							phandle = <0x50c>;
							power-source = <0x00>;
							output-low;
						};

						disp_1p2_pins {

							disp_1p2_pins_default {
								function = "func1";
								pins = "gpio4";
