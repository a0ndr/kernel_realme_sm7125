					qcom,usb-bam-num-pipes = <0x04>;
					interrupts = <0x00 0x84 0x00>;
					qcom,usb-bam-max-mbps-highspeed = <0x190>;
					compatible = "qcom,usb-bam-msm";
					qcom,usb-bam-max-mbps-superspeed = <0xe10>;
					qcom,usb-bam-fifo-baseaddr = <0x146a6000>;
