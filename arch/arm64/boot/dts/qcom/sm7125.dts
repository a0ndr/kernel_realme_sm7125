/dts-v1/;

/ {

	compatible = "qcom,sm7125";
    model = "Qualcomm Inc. SM7125 SoC";

	devtree {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "qcom,atoll-ab-idp", "qcom,atoll-ab", "qcom,idp";
		interrupt-parent = <0x01>;
		model = "IDP";
		oppo,dtsi_no = <0x206b1>;
		qcom,board-id = <0x22 0x00>;
		qcom,msm-id = <0x1bb 0x00>;
		qcom,msm-name = "ATOLL-AB";
		qcom,pmic-name = "PM6150";

		soc {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x00 0xffffffff>;
			phandle = <0x2be>;
			compatible = "simple-bus";

			cti@6f90000 {
				arm,primecell-periphid = <0x3b966>;
				clock-names = "apb_pclk";
				reg-names = "cti-base";
				clocks = <0x1a 0x00>;
				coresight-name = "coresight-cti-ddr_dl_1_cti_0";
				compatible = "arm,primecell";
				reg = <0x6f90000 0x1000>;
				phandle = <0x44a>;
			};

			goodix_fp {
				pinctrl-names = "default";
				pinctrl-0 = <0x3b3>;
				ldo1-config = <0x325aa0 0x325aa0 0x186a0>;
				power-num = <0x01>;
				power-mode = <0x01>;
				goodix,gpio_irq = <0xe3 0x5a 0x01>;
				interrupts = <0x5a 0x00>;
				interrupt-parent = <0xe3>;
				compatible = "goodix,goodix_fp";
				status = "ok";
				ldo1-supply = <0xaa>;
				goodix,gpio_reset = <0xe3 0x5c 0x00>;

				power_source_1 {
					power-name = "ldo1";
					power-mode = <0x01>;
					power-config = "ldo1-config";
					delay-time = <0x00>;
				};
			};

			ipa_smmu_wlan {
				iommus = <0x1e 0x441 0x00>;
				qcom,additional-mapping = <0x1e60000 0x1e60000 0x80000>;
				compatible = "qcom,ipa-smmu-wlan-cb";
				phandle = <0x302>;
			};

			jtagmm@7140000 {
				clock-names = "core_clk";
				reg-names = "etm-base";
				clocks = <0x1a 0x00>;
				compatible = "qcom,jtagv8-mm";
				qcom,coresight-jtagmm-cpu = <0x12>;
				reg = <0x7140000 0x1000>;
				phandle = <0x2c2>;
			};

			qcom,msm-ext-disp {
				compatible = "qcom,msm-ext-disp";
				phandle = <0x501>;

				qcom,msm-ext-disp-audio-codec-rx {
					compatible = "qcom,msm-ext-disp-audio-codec-rx";
					phandle = <0x536>;
				};
			};

			restart@c264000 {
				reg-names = "pshold-base", "tcsr-boot-misc-detect";
				compatible = "qcom,pshold";
				reg = <0xc264000 0x04 0x1fd3000 0x04>;
			};

			rpmh-regulator-ldoa17 {
				qcom,mode-threshold-currents = <0x00 0x01>;
				qcom,regulator-type = "pmic5-ldo";
				compatible = "qcom,rpmh-vrm-regulator";
				qcom,resource-name = "ldoa17";
				mboxes = <0x50 0x00>;
				qcom,supported-modes = <0x02 0x04>;

				regulator-pm6150-l17 {
					regulator-max-microvolt = "", "1Q";
					qcom,init-mode = <0x02>;
					qcom,init-voltage = <0x2c8e40>;
					regulator-min-microvolt = <0x2c8e40>;
					regulator-name = "pm6150_l17";
					qcom,set = <0x03>;
					phandle = <0x70>;
				};
			};

			qcom,dsi-display@9 {
				qcom,dsi-phy-num = <0x00>;
				qcom,dsi-select-clocks = "mux_byte_clk0", "mux_pixel_clk0", "src_byte_clk0", "src_pixel_clk0", "shadow_byte_clk0", "shadow_pixel_clk0";
				qcom,dsi-panel = <0x4f6>;
				qcom,dsi-ctrl-num = <0x00>;
				qcom,display-type = "primary";
				label = "dsi_oppo206B1samsung_ams643xy01_1080_2400_vid_display";
				phandle = <0x500>;
			};

			qcom,msm-pcm-low-latency {
				qcom,msm-pcm-dsp-id = <0x01>;
				qcom,latency-level = "regular";
				compatible = "qcom,msm-pcm-dsp";
				phandle = <0x25e>;
				qcom,msm-pcm-low-latency;
			};

			tpdm@6c40000 {
				arm,primecell-periphid = <0x3b968>;
				qcom,proxy-regs = "vdd", "vdd_cx";
				clock-names = "apb_pclk", "npu_axi_clk", "npu_cfg_ahb_clk", "npu_cc_xo_clk", "npu_core_clk", "npu_core_clk_src";
				reg-names = "tpdm-base";
				qcom,proxy-clks = "npu_axi_clk", "npu_cfg_ahb_clk", "npu_cc_xo_clk", "npu_core_clk", "npu_core_clk_src";
				clocks = <0x1a 0x00 0x1d 0x2c 0x1d 0x30 0x5d 0x16 0x5d 0x0c 0x5d 0x0d>;
				coresight-name = "coresight-tpdm-npu-llm";
				vdd-supply = <0x55>;
				compatible = "arm,primecell";
				reg = <0x6c40000 0x1000>;
				phandle = <0x1e9>;
				vdd_cx-supply = <0x21>;

				port {

					endpoint {
						remote-endpoint = <0x1b1>;
						phandle = <0x1d2>;
					};
				};
			};

			tpdm@7860000 {
				arm,primecell-periphid = <0x3b968>;
				clock-names = "apb_pclk";
				reg-names = "tpdm-base";
				clocks = <0x1a 0x00>;
				coresight-name = "coresight-tpdm-apss";
				compatible = "arm,primecell";
				reg = <0x7860000 0x1000>;
				phandle = <0x3fc>;

				port {

					endpoint {
						remote-endpoint = <0x1cd>;
						phandle = <0x21c>;
					};
				};
			};

			rpmh-regulator-ldoa1 {
				qcom,mode-threshold-currents = <0x00 0x01>;
				qcom,regulator-type = "pmic5-ldo";
				compatible = "qcom,rpmh-vrm-regulator";
				qcom,resource-name = "ldoa1";
				mboxes = <0x50 0x00>;
				qcom,supported-modes = <0x02 0x04>;

				regulator-pm6150-l1 {
					regulator-max-microvolt = <0x132a40>;
					qcom,init-mode = <0x02>;
					qcom,init-voltage = <0x11f990>;
					regulator-min-microvolt = <0x11f990>;
					regulator-name = "pm6150_l1";
					qcom,set = <0x03>;
					phandle = <0x455>;
				};
			};

			qcom,msm-pri-auxpcm {
				qcom,msm-cpudai-auxpcm-quant = <0x02 0x02>;
				qcom,msm-cpudai-auxpcm-frame = <0x05 0x04>;
				qcom,msm-cpudai-auxpcm-sync = <0x01 0x01>;
				qcom,msm-auxpcm-interface = "primary";
				qcom,msm-cpudai-auxpcm-slot-mapping = <0x01 0x01>;
				qcom,msm-cpudai-auxpcm-data = <0x00 0x00>;
				qcom,msm-cpudai-afe-clk-ver = <0x02>;
				qcom,msm-cpudai-auxpcm-num-slots = <0x01 0x01>;
				compatible = "qcom,msm-auxpcm-dev";
				qcom,msm-cpudai-auxpcm-mode = <0x00 0x00>;
				phandle = <0x272>;
				qcom,msm-cpudai-auxpcm-pcm-clk-rate = <0x1f4000 0x1f4000>;
			};

			oplus_sensor {
				compatible = "oplus,sensor-devinfo";
				als-row-coe = <0x6e>;

				free_fall {
					sensor-type = <0x04>;
					is-virtual-sensor;
				};

				gsensor@0 {
					sensor-name = <0x02>;
					sensor-index = <0x00>;
					sensor-direction = <0x07>;
					sensor-type = <0x00>;
				};

				lsensor@0 {
					als-type = <0x02>;
					bus-number = <0x05>;
					normalization_value = <0x225>;
					is-unit-device = <0x01>;
					sensor-name = <0x02>;
					is-als-dri = <0x01>;
					als_buffer_length = <0x0a>;
					is_als_initialed = <0x00>;
					sensor-index = <0x00>;
					sensor-type = <0x03>;
					als-factor = <0x6e>;
					irq-number = <0x5d>;
				};

				lux_aod {
					als-type = <0x01>;
					thrd-high = <0x32>;
					thrd-low = <0x0c>;
					sensor-type = <0x01>;
					is-virtual-sensor;
				};

				fp_display {
					prox-type = <0x00>;
					sensor-type = <0x03>;
					is-virtual-sensor;
				};

				psensor@0 {
					low_limit = <0x190>;
					sampling_count = <0x05>;
					ps_ir_limit = <0x1f4>;
					ps_adjust_min = <0x00>;
					dirty_low_step = <0x64>;
					bus-number = <0x05>;
					anti_shake_delta = <0x50>;
					is_ps_initialzed = <0x00>;
					ps-type = <0x01>;
					offset_range_min = <0xffffff01>;
					step_div = <0x5dc>;
					ps_adjust_max = <0x258>;
					sensor-name = <0x02>;
					offset_range_max = <0xff>;
					raw2offset_radio = <0x5140>;
					step_min = <0x64>;
					sensor-index = <0x00>;
					cali_jitter_limit = <0x14>;
					step_max = <0x190>;
					offset_max = <0xfa>;
					ps_dirty_limit = <0x3fc>;
					dirty_high_step = <0x96>;
					high_step = <0x190>;
					ps-cail-type = <0x02>;
					sensor-type = <0x04>;
					force_cali_limit = <0x7d0>;
					high_limit = <0x258>;
					irq-number = <0x5d>;
					low_step = <0x12c>;
					dynamic_cali_max = <0x400>;
					cal_offset_margin = <0x50>;
				};

				pickup_detect {
					is-need-prox = <0x01>;
					prox-type = <0x00>;
					sensor-type = <0x00>;
					is-virtual-sensor;
				};

				gsensor@1 {
					sensor-name = <0x04>;
					sensor-index = <0x01>;
					sensor-direction = <0x00>;
					sensor-type = <0x00>;
				};

				msensor@0 {
					sensor-name = <0x02>;
					sensor-index = <0x00>;
					sensor-direction = <0x00>;
					sensor-type = <0x02>;

					mag-para2 {
						match-projects = <0x206b3>;
						parameter-number = <0x12>;
						projects-num = <0x01>;
						soft-mag-parameter = <0x26d4 0x00 0x440 0x00 0x6a 0x00 0x2b5 0x00 0x2440 0x00 0xd2 0x00 0x18e 0x00 0x391 0x01 0x2728 0x00>;
					};

					mag-para1 {
						match-projects = <0x206b1 0x206b2 0x206b5>;
						parameter-number = <0x12>;
						projects-num = <0x03>;
						soft-mag-parameter = <0x270c 0x00 0xe6 0x00 0x8b 0x01 0x5b 0x01 0x2635 0x00 0x1e8 0x00 0x01 0x00 0x1e9 0x01 0x288d 0x00>;
					};
				};
			};

			qcom,gdsc@ab00874 {
				qcom,support-hw-trigger;
				regulator-name = "vcodec0_gdsc";
				compatible = "qcom,gdsc";
				status = "ok";
				reg = <0xab00874 0x04>;
				phandle = <0x259>;
			};

			syscon@5091540 {
				compatible = "syscon";
				reg = <0x5091540 0x04>;
				phandle = <0xc0>;
			};

			tpdm@6870000 {
				arm,primecell-periphid = <0x3b968>;
				clock-names = "apb_pclk";
				reg-names = "tpdm-base";
				clocks = <0x1a 0x00>;
				qcom,hw-enable-check;
				coresight-name = "coresight-tpdm-dcc";
				compatible = "arm,primecell";
				reg = <0x6870000 0x1000>;
				phandle = <0x3e4>;

				port {

					endpoint {
						remote-endpoint = <0x1ac>;
						phandle = <0x225>;
					};
				};
			};

			etm@7040000 {
				arm,primecell-periphid = <0xbb95d>;
				clock-names = "apb_pclk";
				clocks = <0x1a 0x00>;
				cpu = <0x11>;
				qcom,tupwr-disable;
				coresight-name = "coresight-etm0";
				compatible = "arm,primecell";
				reg = <0x7040000 0x1000>;
				phandle = <0x3f1>;

				port {

					endpoint {
						remote-endpoint = <0x1c2>;
						phandle = <0x20d>;
					};
				};
			};

			cti@6b01000 {
				arm,primecell-periphid = <0x3b966>;
				clock-names = "apb_pclk";
				reg-names = "cti-base";
				clocks = <0x1a 0x00>;
				coresight-name = "coresight-cti-swao_cti1";
				compatible = "arm,primecell";
				reg = <0x6b01000 0x1000>;
				phandle = <0x439>;
			};

			qcom,msm-pcm-hostless {
				compatible = "qcom,msm-pcm-hostless";
				phandle = <0x264>;
			};

			qcom,msm-dai-tdm-tert-rx {
				qcom,msm-cpudai-tdm-clk-rate = <0x177000>;
				qcom,msm-cpudai-tdm-data-out = <0x00>;
				qcom,msm-cpudai-tdm-data-delay = <0x01>;
				qcom,msm-cpudai-tdm-group-port-id = <0x9020>;
				qcom,msm-cpudai-tdm-group-num-ports = <0x01>;
				qcom,msm-cpudai-tdm-invert-sync = <0x01>;
				compatible = "qcom,msm-dai-tdm";
				qcom,msm-cpudai-tdm-group-id = <0x9120>;
				phandle = <0x499>;
				qcom,msm-cpudai-tdm-sync-src = <0x01>;
				qcom,msm-cpudai-tdm-clk-internal = <0x01>;
				qcom,msm-cpudai-tdm-sync-mode = <0x01>;

				qcom,msm-dai-q6-tdm-tert-rx-0 {
					qcom,msm-cpudai-tdm-dev-id = <0x9020>;
					qcom,msm-cpudai-tdm-data-align = <0x00>;
					compatible = "qcom,msm-dai-q6-tdm";
					phandle = <0x289>;
				};
			};

			tsens@c223000 {
				reg-names = "tsens_srot_physical", "tsens_tm_physical";
				interrupts = <0x00 0x1fb 0x00 0x00 0x1fd 0x00>;
				#thermal-sensor-cells = <0x01>;
				compatible = "qcom,tsens24xx";
				interrupt-names = "tsens-upper-lower", "tsens-critical";
				reg = <0xc223000 0x08 0xc265000 0x1ff>;
				phandle = <0x84>;
				tsens-reinit-wa;
			};

			turing_etm0 {
				qcom,inst-id = <0x0d>;
				coresight-name = "coresight-turing-etm0";
				compatible = "qcom,coresight-remote-etm";
				phandle = <0x3ef>;

				port {

					endpoint {
						remote-endpoint = <0x1c0>;
						phandle = <0x202>;
					};
				};
			};

			qcom,camera-flash@1 {
				cell-index = <0x01>;
				torch-source = <0x2f1 0x2f2>;
				switch-source = <0x2f6 0x2f6>;
				compatible = "qcom,camera-flash";
				status = "ok";
				reg = <0x01 0x00>;
				phandle = <0x4e9>;
				flash-source = <0x2ee 0x2ef>;
			};

			qcom,gpucc@5090000 {
				#reset-cells = <0x01>;
				qcom,gpu_cc_gmu_clk_src-opp-handle = <0x54>;
				reg-names = "cc_base";
				qcom,gpu_cc_gx_gfx3d_clk_src-opp-handle = <0x53>;
				#clock-cells = <0x01>;
				vdd_mx-supply = <0x28>;
				compatible = "qcom,atoll-gpucc", "syscon";
				reg = <0x5090000 0x9000>;
				phandle = <0x59>;
				vdd_cx-supply = <0x21>;
				vdd_gfx-supply = <0x52>;
			};

			replicator@6046000 {
				arm,primecell-periphid = <0x3b909>;
				clock-names = "apb_pclk";
				reg-names = "replicator-base";
				clocks = <0x1a 0x00>;
				coresight-name = "coresight-replicator-qdss";
				compatible = "arm,primecell";
				reg = <0x6046000 0x1000>;
				phandle = <0x419>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@1 {
						reg = <0x00>;

						endpoint {
							slave-mode;
							remote-endpoint = <0x24b>;
							phandle = <0x247>;
						};
					};

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x24a>;
							phandle = <0x24d>;
						};
					};
				};
			};

			msm_cdc_pinctrl@58 {
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x3bd>;
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-1 = <0x3be>;
				phandle = <0x52e>;
			};

			mailbox@18220000 {
				interrupts = <0x00 0x05 0x00>;
				#mbox-cells = <0x01>;
				label = "apps_rsc";
				qcom,drv-id = <0x02>;
				compatible = "qcom,tcs-drv";
				reg = <0x18220000 0x100 0x18220d00 0x3000>;
				phandle = <0x50>;
				qcom,tcs-config = <0x02 0x02 0x00 0x03 0x01 0x03 0x03 0x01>;
			};

			qcom,msm-dai-tdm-pri-rx {
				qcom,msm-cpudai-tdm-clk-rate = <0x177000>;
				qcom,msm-cpudai-tdm-data-out = <0x00>;
				qcom,msm-cpudai-tdm-data-delay = <0x01>;
				qcom,msm-cpudai-tdm-group-port-id = <0x9000>;
				qcom,msm-cpudai-tdm-group-num-ports = <0x01>;
				qcom,msm-cpudai-tdm-invert-sync = <0x01>;
				compatible = "qcom,msm-dai-tdm";
				qcom,msm-cpudai-tdm-group-id = <0x9100>;
				phandle = <0x495>;
				qcom,msm-cpudai-tdm-sync-src = <0x01>;
				qcom,msm-cpudai-tdm-clk-internal = <0x01>;
				qcom,msm-cpudai-tdm-sync-mode = <0x01>;

				qcom,msm-dai-q6-tdm-pri-rx-0 {
					qcom,msm-cpudai-tdm-dev-id = <0x9000>;
					qcom,msm-cpudai-tdm-data-align = <0x00>;
					compatible = "qcom,msm-dai-q6-tdm";
					phandle = <0x285>;
				};
			};

			qcom,gdsc@ad07004 {
				qcom,poll-cfg-gdscr;
				qcom,support-hw-trigger;
				regulator-name = "ipe_0_gdsc";
				compatible = "qcom,gdsc";
				status = "ok";
				reg = <0xad07004 0x04>;
				phandle = <0x2b3>;
			};

			qcom,msm-dai-tdm-tert-tx {
				qcom,msm-cpudai-tdm-clk-rate = <0x177000>;
				qcom,msm-cpudai-tdm-data-out = <0x00>;
				qcom,msm-cpudai-tdm-data-delay = <0x01>;
				qcom,msm-cpudai-tdm-group-port-id = <0x9021>;
				qcom,msm-cpudai-tdm-group-num-ports = <0x01>;
				qcom,msm-cpudai-tdm-invert-sync = <0x01>;
				compatible = "qcom,msm-dai-tdm";
				qcom,msm-cpudai-tdm-group-id = <0x9121>;
				phandle = <0x49a>;
				qcom,msm-cpudai-tdm-sync-src = <0x01>;
				qcom,msm-cpudai-tdm-clk-internal = <0x01>;
				qcom,msm-cpudai-tdm-sync-mode = <0x01>;

				qcom,msm-dai-q6-tdm-tert-tx-0 {
					qcom,msm-cpudai-tdm-dev-id = <0x9021>;
					qcom,msm-cpudai-tdm-data-align = <0x00>;
					compatible = "qcom,msm-dai-q6-tdm";
					phandle = <0x28a>;
				};
			};

			tpda@78c0000 {
				arm,primecell-periphid = <0x3b969>;
				qcom,cmb-elem-size = <0x00 0x20>;
				clock-names = "apb_pclk";
				reg-names = "tpda-base";
				clocks = <0x1a 0x00>;
				coresight-name = "coresight-tpda-llm-silver";
				compatible = "arm,primecell";
				qcom,tpda-atid = <0x48>;
				reg = <0x78c0000 0x1000>;
				phandle = <0x40c>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@1 {
						reg = <0x00>;

						endpoint {
							slave-mode;
							remote-endpoint = <0x218>;
							phandle = <0x1cb>;
						};
					};

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x217>;
							phandle = <0x220>;
						};
					};
				};
			};

			qcom,cpu0-computemon {
				qcom,core-dev-table = <0xbb800 0x478 0x130b00 0x6b8 0x172500 0x826 0x1b8a00 0xb71>;
