							interrupt-names = "wdog-bark", "smb-en", "imp-trigger", "temp-change", "temp-change-smb";
							reg = <0x1600 0x100>;
						};

						qcom,dc@1400 {
							interrupts = <0x00 0x14 0x01 0x03 0x00 0x14 0x02 0x03 0x00 0x14 0x03 0x03 0x00 0x14 0x04 0x03 0x00 0x14 0x05 0x01 0x00 0x14 0x06 0x01 0x00 0x14 0x07 0x01>;
							interrupt-names = "dcin-vashdn", "dcin-uv", "dcin-ov", "dcin-plugin", "dcin-revi", "dcin-pon", "dcin-en";
							reg = <0x1400 0x100>;
