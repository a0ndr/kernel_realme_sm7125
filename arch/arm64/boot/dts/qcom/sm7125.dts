								function = "normal";
								pins = "gpio10";
								bias-high-impedance;
								phandle = <0x55c>;
							};
						};

						nvm_therm {

							nvm_therm_default {
								pins = "gpio1";
								bias-high-impedance;
								phandle = <0x6c>;
							};
						};

						dischg_enable {
							function = "normal";
							pins = "gpio3";
							bias-disable;
