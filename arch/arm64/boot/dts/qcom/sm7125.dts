			pinctrl@3400000 {
				reg-names = "pinctrl", "spi_cfg";
				gpio-controller;
				interrupts = <0x00 0xd0 0x00>;
				compatible = "qcom,atoll-pinctrl";
				#interrupt-cells = <0x02>;
				reg = <0x3400000 0x989000 0x17c000f0 0x60>;
				phandle = <0xe3>;
				#gpio-cells = <0x02>;
				interrupt-controller;

				fsa_usbc_ana_en_n@33 {

					fsa_usbc_ana_en {
						phandle = <0x3b8>;

						config {
							pins = "gpio33";
							drive-strength = <0x02>;
							bias-disable;
							output-low;
						};

						mux {
							function = "gpio";
							pins = "gpio33";
						};
					};
				};

				cam_sensor_mclk4_suspend {
					phandle = <0x3d5>;

					config {
						pins = "gpio23";
						drive-strength = <0x06>;
						bias-pull-down;
					};

					mux {
						function = "cam_mclk";
						pins = "gpio23";
					};
				};

				cci2_active {
					phandle = <0x2b0>;

					config {
						pins = "gpio27", "gpio28";
						drive-strength = <0x02>;
						bias-pull-up;
					};

					mux {
						function = "cci_i2c";
						pins = "gpio27", "gpio28";
					};
				};

				goodix_fp {

					gpio_goodix_irq_default {
						phandle = <0x3b3>;

						config {
							pins = "gpio90";
							drive-strength = <0x02>;
							bias-pull-down;
							input-enable;
						};

						mux {
							function = "gpio";
							pins = "gpio90";
						};
					};
				};

				cci2_suspend {
					phandle = <0x2b1>;

					config {
						pins = "gpio27", "gpio28";
						drive-strength = <0x02>;
						bias-pull-down;
					};

					mux {
						function = "cci_i2c";
