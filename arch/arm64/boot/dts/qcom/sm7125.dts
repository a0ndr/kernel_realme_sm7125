				interrupts = <0x00 0x1cf 0x00>;
				clocks = <0x1d 0x0d 0x1d 0x0e 0x5a 0x21 0x5a 0x4c 0x5a 0x13 0x5a 0x0d 0x5a 0x22 0x5a 0x23>;
